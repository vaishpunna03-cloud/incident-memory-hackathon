# Application
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# Database (defaults to SQLite if PostgreSQL is not configured)
DATABASE_URL=sqlite:///./incident_memory.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_memory

# Memory Provider: "demo" or "hindsight"
# When set to demo, DemoMemoryProvider is used with persistent storage and vector-like similarity
# When credentials are provided, switches to LIVE HINDSIGHT
MEMORY_PROVIDER=demo
HINDSIGHT_API_KEY=
HINDSIGHT_ENDPOINT=https://api.hindsight.dev
HINDSIGHT_TENANT_ID=enterprise-sre

# LLM Provider: "demo", "openai", "gemini", or "anthropic"
# When set to demo, DemoLLMProvider generates deterministic, high-fidelity SRE investigations
# When API key is provided, switches to LIVE AI
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gpt-4o
